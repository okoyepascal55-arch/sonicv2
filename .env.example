# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# Supabase — get these from: https://app.supabase.com → Project Settings → API
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Publii — JSON feed URL that powers the /blog pages.
# In Publii: Website Settings → RSS/JSON feed → enable "Enable JSON feed",
# set "Number of posts in feed" to cover your full archive (there is no
# paginated API — the whole feed is fetched and paged client-side), then
# publish the site. The URL is your published site's root + /feed.json,
# e.g. https://yourdomain.com/feed.json — NOT a local file:// preview path.
VITE_PUBLII_FEED_URL=

# Web3Forms — delivers all site contact/job/quiz form submissions to
# info@sonic-group.de. Get a key at https://web3forms.com (enter that
# email to receive an access key). Without a key, forms silently fall
# back to opening a mailto: link instead of submitting.
VITE_WEB3FORMS_KEY=
